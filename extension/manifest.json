{
  "manifest_version": 3,
  "name": "ytdlp share",
  "version": "1.0.0",
  "description": "Sends the YouTube video in this tab to yt-dlp on this computer and saves it as an MP4.",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download this YouTube video with yt-dlp",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
